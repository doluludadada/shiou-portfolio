---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import MouseGlow from "../components/MouseGlow";
import ThemeToggle from "../components/ThemeToggle";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description = "Ethan Tsai is a full-stack software engineer building Python, PostgreSQL and React systems for data-heavy business workflows.",
  lang = "en",
  canonicalUrl,
  ogImage = "/og.png",
} = Astro.props;
const t = useTranslations(lang);

const homeUrl = lang === "zh" ? "/zh" : "/";
const projectsUrl = lang === "zh" ? "/zh/projects" : "/projects";
const siteUrl = Astro.site || new URL("https://shiou-portfolio.vercel.app");
const canonical =
  canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ethan Tsai" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta property="og:locale" content={lang === "zh" ? "zh_TW" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Alternate language -->
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(
        Astro.url.pathname.replace(/^\/zh/, ""),
        siteUrl
      ).toString()}
    />
    <link
      rel="alternate"
      hreflang="zh-TW"
      href={new URL(
        `/zh${Astro.url.pathname.replace(/^\/zh/, "")}`,
        siteUrl
      ).toString()}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(
        Astro.url.pathname.replace(/^\/zh/, ""),
        siteUrl
      ).toString()}
    />

    <!-- Theme color for browser chrome -->
    <meta
      name="theme-color"
      content="#09090b"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization script (prevent flash) -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "light") {
          document.documentElement.classList.add("light");
        }
      })();
    </script>
  </head>

  <body
    class="min-h-screen flex flex-col theme-transition safe-area-bottom"
    style="background-color: var(--color-bg-primary); color: var(--color-text-primary);"
  >
    <MouseGlow client:load />

    <!-- Skip to main content (Accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:px-4 focus:py-2 focus:rounded-lg theme-glass"
      style="color: var(--color-accent);"
    >
      Skip to main content
    </a>

    <!-- Nav -->
    <header
      class="fixed top-0 left-0 right-0 z-50 theme-glass border-b theme-transition"
      style="border-color: var(--color-border);"
    >
      <nav
        class="w-full px-6 lg:px-16 xl:px-24 h-16 flex items-center justify-between"
      >
        <a
          href={homeUrl}
          class="font-semibold text-lg hover:opacity-80 transition-opacity"
          style="color: var(--color-text-primary);"
        >
          Ethan Tsai<span style="color: var(--color-accent);">.</span>
        </a>

        <div class="flex items-center gap-4 sm:gap-6">
          <div class="hidden sm:flex items-center gap-6 text-sm">
            <a
              href={homeUrl}
              class="hover:opacity-100 transition-opacity"
              style="color: var(--color-text-secondary);"
            >
              {t("nav.home")}
            </a>
            <a
              href={projectsUrl}
              class="hover:opacity-100 transition-opacity"
              style="color: var(--color-text-secondary);"
            >
              {t("nav.projects")}
            </a>
          </div>

          <div
            class="w-px h-5 hidden sm:block"
            style="background-color: var(--color-border);"
          >
          </div>

          <div class="flex items-center gap-2 text-sm">
            <a
              href="/"
              class:list={[
                "px-2 py-1 rounded transition-colors",
                lang === "en" ? "font-medium" : "hover:opacity-100",
              ]}
              style={lang === "en"
                ? "color: var(--color-accent);"
                : "color: var(--color-text-secondary);"}>EN</a
            >
            <a
              href="/zh"
              class:list={[
                "px-2 py-1 rounded transition-colors",
                lang === "zh" ? "font-medium" : "hover:opacity-100",
              ]}
              style={lang === "zh"
                ? "color: var(--color-accent);"
                : "color: var(--color-text-secondary);"}>中</a
            >
          </div>

          <!-- Theme Toggle -->
          <ThemeToggle client:load />

          <a
            href="/playground"
            title={t("nav.playground_tooltip")}
            class="hidden sm:flex items-center px-3 py-1.5 rounded-md border text-sm font-mono theme-transition hover:border-accent"
            style="background-color: var(--color-bg-secondary); border-color: var(--color-border); color: var(--color-text-secondary);"
          >
            &lt;/&gt;
          </a>
        </div>
      </nav>
    </header>

    <main id="main-content" class="flex-1 pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="border-t theme-transition"
      style="border-color: var(--color-border); background-color: var(--color-bg-elevated);"
    >
      <div class="w-full px-6 lg:px-16 xl:px-24 py-12">
        <div
          class="flex flex-col md:flex-row items-center justify-between gap-6"
        >
          <div
            class="flex items-center gap-4 text-sm"
            style="color: var(--color-text-muted);"
          >
            <span>{t("footer.copyright")}</span>
            <span class="hidden md:inline">•</span>
            <span class="hidden md:inline font-mono text-xs"
              >{t("footer.built_with")}</span
            >
          </div>
          <div class="flex items-center gap-4">
            <a
              href="https://github.com/doluludadada"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:opacity-80"
              style="color: var(--color-text-muted);"
              aria-label="GitHub Profile"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/ethan-t-b98b0a267/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:opacity-80"
              style="color: var(--color-text-muted);"
              aria-label="LinkedIn Profile"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Ethan Tsai",
        alternateName: ["蔡易修"],
        url: siteUrl.toString(),
        jobTitle: "Full-Stack Software Engineer",
        worksFor: {
          "@type": "Organisation",
          name: "American Club Taipei",
        },
        sameAs: [
          "https://github.com/doluludadada",
          "https://www.linkedin.com/in/ethan-t-b98b0a267/",
        ],
        knowsAbout: [
          "Python",
          "FastAPI",
          "React",
          "TypeScript",
          "PostgreSQL",
          "ETL",
          "System Integration",
          "Full-Stack Development",
        ],
      })}
    />
  </body>
</html>

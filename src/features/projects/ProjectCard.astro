---
// src/features/projects/ProjectCard.astro
import type { Lang, UIKey } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import { ArrowUpRight, Github, Lock, ExternalLink } from "lucide-react";

interface Props {
  lang: Lang;
  projectId: string;
  featured?: boolean;
  tech: string[];
  repoUrl?: string;
  liveUrl?: string;
  comingSoon?: boolean;
}

const {
  lang,
  projectId,
  featured = false,
  tech,
  repoUrl,
  liveUrl,
  comingSoon,
} = Astro.props;
const t = useTranslations(lang);

// FIX: Explicitly cast to UIKey
const titleKey = `project.${projectId}.title` as UIKey;
const summaryKey = `project.${projectId}.summary` as UIKey;
---

<article
  class={`group relative overflow-hidden rounded-2xl border border-border bg-surface/50 backdrop-blur-sm hover:border-border-hover transition-all duration-300 ${featured ? "md:col-span-2" : ""}`}
>
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
  >
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-px bg-linear-to-r from-transparent via-accent to-transparent"
    >
    </div>
  </div>

  <div class="p-6 h-full flex flex-col">
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        {
          featured && (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-accent/10 text-accent mb-2">
              ⭐ Featured
            </span>
          )
        }
        <h3
          class="text-xl font-semibold text-foreground group-hover:text-accent transition-colors"
        >
          {t(titleKey)}
        </h3>
      </div>

      <ArrowUpRight
        className="w-5 h-5 text-muted opacity-0 group-hover:opacity-100 group-hover:text-accent transition-all transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
      />
    </div>

    <p class="text-muted-foreground text-sm leading-relaxed mb-6 flex-1">
      {t(summaryKey)}
    </p>

    <div class="flex flex-wrap gap-2 mb-6">
      {
        tech
          .slice(0, featured ? 6 : 4)
          .map((item) => (
            <span class="px-2 py-1 rounded-md bg-surface-elevated text-muted-foreground text-xs font-mono border border-border">
              {item}
            </span>
          ))
      }
      {
        tech.length > (featured ? 6 : 4) && (
          <span class="px-2 py-1 rounded-md bg-surface-elevated text-muted text-xs">
            +{tech.length - (featured ? 6 : 4)}
          </span>
        )
      }
    </div>

    <div class="flex items-center gap-3 pt-4 border-t border-border">
      <a
        href={`/${lang}/projects/${projectId}`}
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-accent transition-colors"
      >
        {t("projects.view_case_study")}
        <ArrowUpRight className="w-4 h-4" />
      </a>

      <div class="flex-1"></div>

      {/* Source code link or proprietary badge */}
      {
        repoUrl ? (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg hover:bg-surface-hover text-muted-foreground hover:text-foreground transition-colors"
            title={t("projects.source_code")}
          >
            <Github className="w-4 h-4" />
          </a>
        ) : (
          <span
            class="inline-flex items-center gap-1 text-xs text-muted"
            title={t("projects.proprietary")}
          >
            <Lock className="w-3 h-3" />
            <span class="hidden sm:inline">Enterprise</span>
          </span>
        )
      }

      {/* Live demo */}
      {
        liveUrl && !comingSoon && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg hover:bg-surface-hover text-muted-foreground hover:text-foreground transition-colors"
            title={t("projects.live_demo")}
          >
            <ExternalLink className="w-4 h-4" />
          </a>
        )
      }

      {
        comingSoon && (
          <span class="text-xs text-muted italic">
            {t("projects.coming_soon")}
          </span>
        )
      }
    </div>
  </div>
</article>

---
import ProjectCard from "./ProjectCard.astro";
import { useTranslations } from "../../../shared/i18n/utils";
import type { Lang } from "../../../shared/i18n/ui";
import { projectsConfig } from "../config";

interface Props {
  lang?: Lang;
  featuredOnly?: boolean;
  showViewAll?: boolean;
}

const { lang = "en", featuredOnly = false, showViewAll = true } = Astro.props;
const t = useTranslations(lang);
const projectsUrl = lang === "zh" ? "/zh/projects" : "/projects";

// Filter based on props
const displayProjects = featuredOnly
  ? projectsConfig.filter((p) => p.featured)
  : projectsConfig;
---

<section class="py-20 px-6 lg:px-12 xl:px-16 2xl:px-24">
  <div
    class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4"
  >
    <div>
      <h2
        class="text-3xl font-bold mb-2"
        style="color: var(--color-text-primary);"
      >
        {t("projects.title")}
      </h2>
      <p class="text-lg" style="color: var(--color-text-secondary);">
        {t("projects.subtitle")}
      </p>
    </div>

    {
      showViewAll && featuredOnly && (
        <a
          href={projectsUrl}
          class="inline-flex items-center gap-2 text-sm transition-colors group hover:opacity-80"
          style="color: var(--color-accent);"
        >
          {t("projects.view_all")}
          <svg
            class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            />
          </svg>
        </a>
      )
    }
  </div>

  <div
    class="grid grid-flow-row-dense grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-6"
  >
    {
      displayProjects.map((project) => (
        <ProjectCard
          lang={lang}
          projectId={project.id}
          featured={project.featured}
          tech={project.tech}
          repoUrl={project.repoUrl}
          comingSoon={project.comingSoon}
        />
      ))
    }
  </div>
</section>

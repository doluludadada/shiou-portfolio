---
import type { Lang } from "@/shared/i18n/ui";
import { useTranslations } from "@/shared/i18n/utils";
import { ArrowUpRight, Github, Lock } from "lucide-react";

interface Props {
  lang: Lang;
  projectId: string;
  featured?: boolean;
  tech: string[];
  repoUrl?: string;
  comingSoon?: boolean;
}

const {
  lang,
  projectId,
  featured = false,
  tech,
  repoUrl,
  comingSoon,
} = Astro.props;

const t = useTranslations(lang);
const projectsBase = lang === "zh" ? "/zh/projects" : "/projects";

// Dynamic keys
const title = t(`project.${projectId}.title` as any);
const summary = t(`project.${projectId}.summary` as any);
---

<article
  class={`group relative overflow-hidden rounded-2xl border theme-card theme-transition ${featured ? "md:col-span-2" : ""}`}
  style="background-color: var(--color-bg-elevated); border-color: var(--color-border);"
>
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
  >
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-px"
      style="background: linear-gradient(to right, transparent, var(--color-accent), transparent);"
    >
    </div>
  </div>

  <div class="p-6 h-full flex flex-col">
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        {
          featured && (
            <span
              class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium mb-2"
              style="background-color: var(--color-accent-glow); color: var(--color-accent);"
            >
              ⭐ {t("projects.featured")}
            </span>
          )
        }
        <h3
          class="text-xl font-semibold transition-colors group-hover:text-(--color-accent)"
          style="color: var(--color-text-primary);"
        >
          {title}
        </h3>
      </div>
      <ArrowUpRight
        className="w-5 h-5 opacity-0 group-hover:opacity-100 transition-all transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        style={{ color: "var(--color-accent)" }}
      />
    </div>

    <p
      class="text-sm leading-relaxed mb-6 flex-1"
      style="color: var(--color-text-secondary);"
    >
      {summary}
    </p>

    <div class="flex flex-wrap gap-2 mb-6">
      {
        tech.slice(0, featured ? 6 : 4).map((item) => (
          <span
            class="px-2 py-1 rounded-md text-xs font-mono border"
            style="background-color: var(--color-bg-tertiary); border-color: var(--color-border-subtle); color: var(--color-text-secondary);"
          >
            {item}
          </span>
        ))
      }
      {
        tech.length > (featured ? 6 : 4) && (
          <span
            class="px-2 py-1 rounded-md text-xs"
            style="background-color: var(--color-bg-tertiary); color: var(--color-text-muted);"
          >
            +{tech.length - (featured ? 6 : 4)}
          </span>
        )
      }
    </div>

    <div
      class="flex items-center gap-3 pt-4 border-t"
      style="border-color: var(--color-border);"
    >
      <a
        href={`${projectsBase}/${projectId}`}
        class="inline-flex items-center gap-2 text-sm transition-colors hover:text-(--color-accent)"
        style="color: var(--color-text-secondary);"
      >
        {t("projects.case_study")}
        <ArrowUpRight className="w-4 h-4" />
      </a>
      <div class="flex-1"></div>
      {
        repoUrl ? (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg transition-colors hover:bg-(--color-bg-tertiary)"
            style="color: var(--color-text-secondary);"
            aria-label="View source code on GitHub"
          >
            <Github className="w-4 h-4" />
          </a>
        ) : (
          <span
            class="inline-flex items-center gap-1 text-xs"
            style="color: var(--color-text-muted);"
          >
            <Lock className="w-3 h-3" />
            <span class="hidden sm:inline">{t("projects.enterprise")}</span>
          </span>
        )
      }
      {
        comingSoon && (
          <span class="text-xs italic" style="color: var(--color-accent);">
            {t("projects.coming_soon")}
          </span>
        )
      }
    </div>
  </div>
</article>

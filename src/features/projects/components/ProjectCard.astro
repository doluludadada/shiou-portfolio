---
import type { Lang } from "@/shared/i18n/ui";
import { useTranslations } from "@/shared/i18n/utils";
import { ArrowUpRight, Github, Lock } from "lucide-react";


interface Props {
  lang: Lang;
  projectId: string;
  featured?: boolean;
  tech: string[];
  repoUrl?: string;
  comingSoon?: boolean;
}

const {
  lang,
  projectId,
  featured = false,
  tech,
  repoUrl,
  comingSoon,
} = Astro.props;

const t = useTranslations(lang);
const projectsBase = lang === "zh" ? "/zh/projects" : "/projects";

// Dynamic keys
const title = t(`project.${projectId}.title` as any);
const summary = t(`project.${projectId}.summary` as any);
---

<article
  class={`group relative overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/50 hover:border-cyan-500/50 transition-all duration-300 ${featured ? "md:col-span-2" : ""}`}
>
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
  >
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-px bg-linear-to-r from-transparent via-cyan-500 to-transparent"
    >
    </div>
  </div>

  <div class="p-6 h-full flex flex-col">
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        {
          featured && (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cyan-500/10 text-cyan-400 mb-2">
              ⭐ {t("projects.featured")}
            </span>
          )
        }
        <h3
          class="text-xl font-semibold text-zinc-100 group-hover:text-cyan-400 transition-colors"
        >
          {title}
        </h3>
      </div>
      <ArrowUpRight
        className="w-5 h-5 text-zinc-600 opacity-0 group-hover:opacity-100 group-hover:text-cyan-400 transition-all transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
      />
    </div>

    <p class="text-zinc-400 text-sm leading-relaxed mb-6 flex-1">{summary}</p>

    <div class="flex flex-wrap gap-2 mb-6">
      {
        tech
          .slice(0, featured ? 6 : 4)
          .map((item) => (
            <span class="px-2 py-1 rounded-md bg-zinc-800 text-zinc-400 text-xs font-mono border border-zinc-700">
              {item}
            </span>
          ))
      }
      {
        tech.length > (featured ? 6 : 4) && (
          <span class="px-2 py-1 rounded-md bg-zinc-800 text-zinc-500 text-xs">
            +{tech.length - (featured ? 6 : 4)}
          </span>
        )
      }
    </div>

    <div class="flex items-center gap-3 pt-4 border-t border-zinc-800">
      <a
        href={`${projectsBase}/${projectId}`}
        class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-cyan-400 transition-colors"
      >
        {t("projects.case_study")}
        <ArrowUpRight className="w-4 h-4" />
      </a>
      <div class="flex-1"></div>
      {
        repoUrl ? (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg hover:bg-zinc-800 text-zinc-400 hover:text-zinc-100 transition-colors"
          >
            <Github className="w-4 h-4" />
          </a>
        ) : (
          <span class="inline-flex items-center gap-1 text-xs text-zinc-500">
            <Lock className="w-3 h-3" />
            <span class="hidden sm:inline">{t("projects.enterprise")}</span>
          </span>
        )
      }
      {
        comingSoon && (
          <span class="text-xs text-cyan-400 italic">
            {t("projects.coming_soon")}
          </span>
        )
      }
    </div>
  </div>
</article>

---
// src/features/projects/ProjectList.astro
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  lang: Lang;
  featuredOnly?: boolean;
  showViewAll?: boolean;
}

const { lang, featuredOnly = false, showViewAll = true } = Astro.props;
const t = useTranslations(lang);

// Project data
const projects = [
  {
    id: "datacontrol",
    featured: true,
    category: "fullstack",
    tech: ["Python", "FastAPI", "React", "TypeScript", "PostgreSQL", "Docker", "GitLab CI"],
  },
  {
    id: "authhub",
    featured: true,
    category: "fullstack",
    tech: ["Python", "FastAPI", "React", "TypeScript", "PostgreSQL", "Redis", "JWT"],
  },
  {
    id: "pbill",
    featured: false,
    category: "backend",
    tech: ["Python", "Docker", "SQLite", "Mandrill API"],
  },
  {
    id: "gate",
    featured: false,
    category: "fullstack",
    tech: ["C#", "JavaScript", "PostgreSQL", "Clean Architecture"],
  },
  {
    id: "staff",
    featured: false,
    category: "fullstack",
    tech: ["Python", "FastAPI", "React", "TypeScript", "PostgreSQL"],
  },
  {
    id: "marketing",
    featured: false,
    category: "fullstack",
    tech: ["Python", "FastAPI", "React", "PostgreSQL", "pandas"],
  },
  {
    id: "abacus",
    featured: false,
    category: "backend",
    tech: ["Python", "FastAPI", "PostgreSQL", "InterBase Migration"],
  },
  {
    id: "dayu",
    featured: false,
    category: "side",
    tech: ["Python", "FastAPI", "React", "Astro", "Docker", "Caddy", "AWS EC2"],
    comingSoon: true,
  },
  {
    id: "llmgateway",
    featured: false,
    category: "side",
    tech: ["Python", "FastAPI", "Redis", "LINE API", "OpenAI"],
    repoUrl: "https://github.com/doluludadada/chat_friend",
  },
];

const displayProjects = featuredOnly 
  ? projects.filter(p => p.featured)
  : projects;
---

<section class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="text-3xl font-bold text-foreground mb-2">
          {t("projects.title")}
        </h2>
        <p class="text-muted-foreground text-lg">
          {t("projects.subtitle")}
        </p>
      </div>
      
      {showViewAll && featuredOnly && (
        <a
          href={`/${lang}/projects`}
          class="inline-flex items-center gap-2 text-sm text-accent hover:text-accent/80 transition-colors group"
        >
          View all projects
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      )}
    </div>

    {/* Project Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {displayProjects.map((project) => (
        <ProjectCard
          lang={lang}
          projectId={project.id}
          featured={project.featured}
          tech={project.tech}
          repoUrl={project.repoUrl}
          comingSoon={project.comingSoon}
        />
      ))}
    </div>
  </div>
</section>

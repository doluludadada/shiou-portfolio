---
import TimelineFun from "@/shared/components/Timeline";
import type { Lang } from "@/shared/i18n/ui";
import { useTranslations } from "@/shared/i18n/utils";
import { timelineConfig } from "../config";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

// Merge config with i18n strings dynamically
const items = timelineConfig.map((item) => ({
  ...item,
  company: t(`timeline.${item.id}.company` as any),
  role: t(`timeline.${item.id}.role` as any),
  description: t(`timeline.${item.id}.desc` as any),
}));
---

<section class="py-20 px-6 lg:px-16 xl:px-24 relative overflow-hidden">
  <!-- Background glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 rounded-full blur-[128px]"
    style="background: var(--color-accent-glow);"
  >
  </div>

  <div class="relative max-w-4xl mx-auto">
    <div class="mb-12">
      <h2
        class="text-3xl lg:text-4xl font-bold mb-4"
        style="color: var(--color-text-primary);"
      >
        {t("timeline.title")}
      </h2>
      <p class="text-lg max-w-xl" style="color: var(--color-text-secondary);">
        {t("timeline.subtitle")}
      </p>
    </div>

    <TimelineFun client:visible items={items} />
  </div>
</section>

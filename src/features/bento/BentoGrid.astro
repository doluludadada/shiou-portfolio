---
import { Layers, Zap, Hexagon, Code2 } from "lucide-react";
import CountUp from "../../shared/components/CountUp";
import { useTranslations } from "../../shared/i18n/utils";
import type { Lang } from "../../shared/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const techStack = {
  backend: ["Python", "FastAPI", "PostgreSQL", "SQLAlchemy"],
  frontend: ["React", "TypeScript"],
  devops: ["Docker", "Linux", "GitLab CI/CD"],
};
---

<section class="py-20 px-6 lg:px-16 xl:px-24">
  <div class="mb-12">
    <h2 class="text-2xl font-bold mb-2 text-text-primary">
      {t("bento.title")}
    </h2>
    <div class="w-12 h-1 rounded-full bg-accent"></div>
  </div>

  <div
    class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 auto-rows-[140px]"
  >
    <div
      class="col-span-2 row-span-2 group relative overflow-hidden rounded-2xl border p-6 theme-card theme-transition bg-bg-secondary border-border"
    >
      <div
        class="absolute top-0 right-0 w-32 h-32 rounded-full blur-2xl transition-colors bg-accent-glow"
      >
      </div>
      <div class="relative h-full flex flex-col justify-between">
        <div>
          <Layers className="w-6 h-6 mb-4 text-accent" />
          <p class="text-sm text-text-secondary">
            {t("bento.projects_sub")}
          </p>
        </div>
        <div>
          <span
            class="text-6xl lg:text-7xl font-bold text-transparent bg-clip-text bg-linear-to-r from-accent to-[#67e8f9]"
          >
            <CountUp client:visible end={6} duration={2000} />
          </span>
          <p class="text-lg mt-2 text-text-primary">
            {t("bento.projects_label")}
          </p>
        </div>
      </div>
    </div>

    <div
      class="col-span-1 row-span-1 group relative overflow-hidden rounded-2xl border p-4 theme-card theme-transition bg-bg-secondary border-border"
    >
      <div class="h-full flex flex-col justify-between">
        <Zap className="w-5 h-5 text-accent" />
        <div>
          <span class="text-3xl font-bold text-text-primary">
            <CountUp client:visible end={94} suffix="%" duration={2500} />
          </span>
          <p class="text-xs mt-1 text-text-secondary">
            {t("bento.perf_label")}
          </p>
        </div>
      </div>
    </div>

    <div
      class="col-span-1 row-span-1 group rounded-2xl border p-4 theme-card theme-transition bg-bg-secondary border-border"
    >
      <div class="h-full flex flex-col justify-between">
        <Hexagon className="w-5 h-5 text-accent" />
        <div>
          <span class="text-2xl font-bold font-mono text-text-primary">
            {t("bento.arch")}
          </span>
          <p class="text-xs mt-1 text-text-secondary">
            {t("bento.arch_label")}
          </p>
        </div>
      </div>
    </div>

    <div
      class="col-span-2 row-span-1 rounded-2xl border p-4 theme-transition border-border bg-linear-to-br from-bg-secondary to-bg-elevated"
    >
      <div class="h-full flex items-center justify-between">
        <div>
          <p class="text-sm mb-1 text-text-secondary">
            {t("bento.perf_sub")}
          </p>
          <div class="flex items-center gap-3">
            <span class="line-through text-text-muted">
              {t("bento.perf_old")}
            </span>
            <svg
              class="w-5 h-5 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
            <span class="text-2xl font-bold text-accent">
              {t("bento.perf_new")}
            </span>
          </div>
        </div>
        <div class="hidden md:flex items-end gap-1 h-12">
          <div class="w-3 rounded-t h-full bg-border-subtle"></div>
          <div class="w-3 rounded-t h-[5%] bg-accent"></div>
        </div>
      </div>
    </div>

    <div
      class="col-span-2 lg:col-span-4 row-span-1 rounded-2xl border p-4 theme-transition bg-bg-secondary border-border"
    >
      <div class="h-full flex flex-col justify-between">
        <div class="flex items-center gap-2">
          <Code2 className="w-5 h-5 text-accent" />
          <span class="text-sm font-medium text-text-primary">
            {t("bento.stack_label")}
          </span>
        </div>
        <div class="flex flex-wrap gap-2">
          {
            techStack.backend.map((tech) => (
              <span class="px-2 py-1 rounded-md text-xs font-mono bg-cyan-400/10 text-accent">
                {tech}
              </span>
            ))
          }
          {
            techStack.frontend.map((tech) => (
              <span class="px-2 py-1 rounded-md text-xs font-mono bg-purple-500/10 text-[#a855f7]">
                {tech}
              </span>
            ))
          }
          {
            techStack.devops.map((tech) => (
              <span class="px-2 py-1 rounded-md text-xs font-mono bg-orange-400/10 text-[#fb923c]">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

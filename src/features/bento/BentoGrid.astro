---
import { Layers, Zap, Hexagon, Code2 } from "lucide-react";
import CountUp from "../../shared/components/CountUp";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const techStack = {
  backend: ["Python", "FastAPI", "C#", ".NET"],
  frontend: ["React", "TypeScript", "Astro"],
  devops: ["Docker", "GitLab CI"],
};
---

<section class="py-20 px-6 lg:px-16 xl:px-24">
  <div class="mb-12">
    <h2 class="text-2xl font-bold text-zinc-100 mb-2">{t("bento.title")}</h2>
    <div class="w-12 h-1 bg-cyan-500 rounded-full"></div>
  </div>

  <div
    class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 auto-rows-[140px]"
  >
    <!-- Projects Count -->
    <div
      class="col-span-2 row-span-2 group relative overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 p-6 hover:border-cyan-500/50 transition-all"
    >
      <div
        class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-colors"
      >
      </div>
      <div class="relative h-full flex flex-col justify-between">
        <div>
          <Layers className="w-6 h-6 text-cyan-400 mb-4" />
          <p class="text-sm text-zinc-400">{t("bento.projects_sub")}</p>
        </div>
        <div>
          <span
            class="text-6xl lg:text-7xl font-bold bg-linear-to-r from-cyan-400 to-cyan-300 bg-clip-text text-transparent"
          >
            <CountUp client:visible end={7} duration={2000} />
          </span>
          <p class="text-lg text-zinc-100 mt-2">{t("bento.projects_label")}</p>
        </div>
      </div>
    </div>

    <!-- Performance -->
    <div
      class="col-span-1 row-span-1 group relative overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 p-4 hover:border-cyan-500/50 transition-all"
    >
      <div class="h-full flex flex-col justify-between">
        <Zap className="w-5 h-5 text-cyan-400" />
        <div>
          <span class="text-3xl font-bold text-zinc-100">
            <CountUp client:visible end={95} suffix="%" duration={2500} />
          </span>
          <p class="text-xs text-zinc-400 mt-1">{t("bento.perf_label")}</p>
        </div>
      </div>
    </div>

    <!-- Architecture -->
    <div
      class="col-span-1 row-span-1 group rounded-2xl border border-zinc-800 bg-zinc-900 p-4 hover:border-cyan-500/50 transition-all"
    >
      <div class="h-full flex flex-col justify-between">
        <Hexagon className="w-5 h-5 text-cyan-400" />
        <div>
          <span class="text-2xl font-bold text-zinc-100 font-mono"
            >{t("bento.arch")}</span
          >
          <p class="text-xs text-zinc-400 mt-1">{t("bento.arch_label")}</p>
        </div>
      </div>
    </div>

    <!-- Performance Detail -->
    <div
      class="col-span-2 row-span-1 rounded-2xl border border-zinc-800 bg-linear-to-br from-zinc-900 to-zinc-900/50 p-4"
    >
      <div class="h-full flex items-center justify-between">
        <div>
          <p class="text-sm text-zinc-400 mb-1">{t("bento.perf_sub")}</p>
          <div class="flex items-center gap-3">
            <span class="text-zinc-500 line-through">3 hrs</span>
            <svg
              class="w-5 h-5 text-cyan-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
            <span class="text-2xl font-bold text-cyan-400">10 min</span>
          </div>
        </div>
        <div class="hidden md:flex items-end gap-1 h-12">
          <div class="w-3 bg-zinc-700 rounded-t h-full"></div>
          <div class="w-3 bg-cyan-400 rounded-t" style="height: 5%"></div>
        </div>
      </div>
    </div>

    <!-- Tech Stack -->
    <div
      class="col-span-2 lg:col-span-4 row-span-1 rounded-2xl border border-zinc-800 bg-zinc-900 p-4"
    >
      <div class="h-full flex flex-col justify-between">
        <div class="flex items-center gap-2">
          <Code2 className="w-5 h-5 text-cyan-400" />
          <span class="text-sm font-medium text-zinc-100"
            >{t("bento.stack_label")}</span
          >
        </div>
        <div class="flex flex-wrap gap-2">
          {
            techStack.backend.map((tech) => (
              <span class="px-2 py-1 rounded-md bg-cyan-500/10 text-cyan-400 text-xs font-mono">
                {tech}
              </span>
            ))
          }
          {
            techStack.frontend.map((tech) => (
              <span class="px-2 py-1 rounded-md bg-purple-500/10 text-purple-400 text-xs font-mono">
                {tech}
              </span>
            ))
          }
          {
            techStack.devops.map((tech) => (
              <span class="px-2 py-1 rounded-md bg-orange-500/10 text-orange-400 text-xs font-mono">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

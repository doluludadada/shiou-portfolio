---
import { ArrowRightLeft, DatabaseZap, ServerCog } from "lucide-react";
import { useTranslations } from "../../shared/i18n/utils";
import type { Lang } from "../../shared/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const cards = [
  {
    icon: ArrowRightLeft,
    title: t("impact.etl.title"),
    body: t("impact.etl.body"),
    featured: true,
  },
  {
    icon: DatabaseZap,
    title: t("impact.billing.title"),
    body: t("impact.billing.body"),
  },
  {
    icon: ServerCog,
    title: t("impact.ownership.title"),
    body: t("impact.ownership.body"),
  },
];
---

<section class="px-6 py-20 lg:px-16 xl:px-24">
  <div class="mx-auto max-w-7xl">
    <div class="mb-10 max-w-3xl">
      <p class="mb-4 font-mono text-xs font-semibold tracking-[0.18em] text-accent">
        {t("impact.eyebrow")}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-text-primary lg:text-5xl">
        {t("impact.title")}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-text-secondary">
        {t("impact.intro")}
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {
        cards.map(({ icon: Icon, title, body, featured }) => (
          <article
            class:list={[
              "relative overflow-hidden rounded-2xl border p-6 theme-transition",
              featured
                ? "border-accent/40 bg-accent-glow"
                : "border-border bg-bg-secondary",
            ]}
          >
            <Icon className="mb-8 h-6 w-6 text-accent" />
            <h3 class="mb-3 text-xl font-semibold text-text-primary">{title}</h3>
            <p class="text-sm leading-7 text-text-secondary">{body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

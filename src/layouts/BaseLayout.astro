---
import "../styles/global.css";
import MouseGlow from "../shared/components/MouseGlow";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "zh";
}

const { title, description = "", lang = "en" } = Astro.props;

const homeUrl = lang === "zh" ? "/zh" : "/";
const projectsUrl = lang === "zh" ? "/zh/projects" : "/projects";
const switchLangUrl = lang === "zh" ? "/" : "/zh";

const nav = {
  en: { home: "Home", projects: "Projects" },
  zh: { home: "首頁", projects: "專案作品" },
}[lang];
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen flex flex-col bg-zinc-950 text-zinc-100">
    <MouseGlow client:load />

    <!-- Nav -->
    <header
      class="fixed top-0 left-0 right-0 z-50 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800"
    >
      <nav
        class="w-full px-6 lg:px-16 xl:px-24 h-16 flex items-center justify-between"
      >
        <a
          href={homeUrl}
          class="font-semibold text-lg hover:text-cyan-400 transition-colors"
        >
          YiShiou<span class="text-cyan-400">.</span>
        </a>

        <div class="flex items-center gap-6">
          <div class="hidden sm:flex items-center gap-6 text-sm">
            <a
              href={homeUrl}
              class="text-zinc-400 hover:text-zinc-100 transition-colors"
              >{nav.home}</a
            >
            <a
              href={projectsUrl}
              class="text-zinc-400 hover:text-zinc-100 transition-colors"
              >{nav.projects}</a
            >
          </div>

          <div class="w-px h-5 bg-zinc-800 hidden sm:block"></div>

          <div class="flex items-center gap-2 text-sm">
            <a
              href="/"
              class:list={[
                "px-2 py-1 rounded transition-colors",
                lang === "en"
                  ? "text-cyan-400 font-medium"
                  : "text-zinc-400 hover:text-zinc-100",
              ]}>EN</a
            >
            <a
              href="/zh"
              class:list={[
                "px-2 py-1 rounded transition-colors",
                lang === "zh"
                  ? "text-cyan-400 font-medium"
                  : "text-zinc-400 hover:text-zinc-100",
              ]}>中</a
            >
          </div>

          <a
            href="/playground"
            class="hidden sm:flex items-center px-3 py-1.5 rounded-md bg-zinc-900 border border-zinc-800 text-sm font-mono text-zinc-400 hover:text-cyan-400 transition-all"
          >
            &lt;/&gt;
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-1 pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800 bg-zinc-900/50">
      <div class="w-full px-6 lg:px-16 xl:px-24 py-12">
        <div
          class="flex flex-col md:flex-row items-center justify-between gap-6"
        >
          <div class="flex items-center gap-4 text-sm text-zinc-500">
            <span>© 2025 YiShiou Tsai</span>
            <span class="hidden md:inline">•</span>
            <span class="hidden md:inline font-mono text-xs"
              >Built with Astro, React & Tailwind</span
            >
          </div>
          <div class="flex items-center gap-4">
            <a
              href="https://github.com/doluludadada"
              target="_blank"
              class="text-zinc-500 hover:text-zinc-100 transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path></svg
              >
            </a>
            <a
              href="https://www.linkedin.com/in/yishiou-t-b98b0a267/"
              target="_blank"
              class="text-zinc-500 hover:text-zinc-100 transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

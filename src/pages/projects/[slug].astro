---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ArrowLeft, Github, Lock, Layers, Zap, Code2 } from "lucide-react";

export function getStaticPaths() {
  const slugs = [
    "datacontrol",
    "authhub",
    "pbill",
    "gate",
    "staff",
    "marketing",
    "abacus",
    "dayu",
    "llmgateway",
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const projects: Record<string, any> = {
  datacontrol: {
    title: "Data Control ETL",
    summary:
      "Mission-critical ETL platform modernisation. Migrated from C# console to FastAPI + React.",
    tech: [
      "Python 3.13",
      "FastAPI",
      "React 18",
      "TypeScript",
      "PostgreSQL",
      "Docker",
      "GitLab CI",
    ],
    highlights: [
      "95% reduction in processing time (3hrs → 10min)",
      "Clean Architecture with strict layer separation",
      "Real-time monitoring dashboard",
      "Automated CI/CD deployment",
    ],
    hasArchitecture: true,
    metrics: [
      { label: "Performance", value: "95%", sub: "Faster" },
      { label: "Processing", value: "10 min", sub: "vs 3hrs" },
    ],
  },
  authhub: {
    title: "AuthHub SSO",
    summary:
      "Centralised identity management and single sign-on for internal applications.",
    tech: [
      "Python 3.13",
      "FastAPI",
      "React 19",
      "TypeScript",
      "PostgreSQL",
      "Redis",
      "JWT",
    ],
    highlights: [
      "JWT authentication with RS256/HS256",
      "Role-based access control per app",
      "Redis session management",
      "Ticket-based SSO flow",
    ],
    hasArchitecture: true,
    metrics: [{ label: "Apps", value: "7", sub: "Integrated" }],
  },
  pbill: {
    title: "PBill Email System",
    summary: "Automated paperless billing with PDF attachment distribution.",
    tech: ["Python", "Docker", "SQLite", "Mandrill API", "FastAPI"],
    highlights: [
      "90% reduction in file read time via caching",
      "Fault-tolerant with automatic recovery",
      "Mandrill API for reliable delivery",
      "Docker containerisation",
    ],
  },
  gate: {
    title: "Gate Reader System",
    summary: "Physical access control integration with card reader hardware.",
    tech: ["C#", ".NET", "JavaScript", "PostgreSQL", "Clean Architecture"],
    highlights: [
      "First frontend project with vanilla JS",
      "Clean Architecture in C#",
      "Real-time PostgreSQL sync",
    ],
  },
  staff: {
    title: "Staff Management",
    summary: "Employee database and physical access permission management.",
    tech: ["Python", "FastAPI", "React", "TypeScript", "PostgreSQL", "Zustand"],
    highlights: [
      "Full CRUD with React Hook Form + Zod",
      "Access group management with time rules",
      "AuthHub SSO integration",
    ],
  },
  marketing: {
    title: "Marketing System",
    summary:
      "Campaign slot management with Excel bulk upload and member tagging.",
    tech: ["Python", "FastAPI", "React", "TypeScript", "PostgreSQL", "pandas"],
    highlights: [
      "10-slot campaign architecture",
      "PostgreSQL advisory locks for concurrency",
      "Excel processing with pandas",
    ],
  },
  abacus: {
    title: "Abacus Migration",
    summary: "Database migration from InterBase to PostgreSQL with modern API.",
    tech: [
      "Python",
      "FastAPI",
      "React",
      "TypeScript",
      "PostgreSQL",
      "InterBase",
    ],
    highlights: [
      "Legacy ODBC to modern SQLAlchemy",
      "FastAPI + React + TypeScript stack",
    ],
  },
  dayu: {
    title: "DaYu Tour System",
    summary:
      "Full-stack travel agency platform. Freelance project with complete ownership.",
    tech: [
      "Python",
      "FastAPI",
      "React",
      "Astro",
      "TypeScript",
      "PostgreSQL",
      "Docker",
      "AWS",
    ],
    highlights: [
      "FastAPI backend with Clean Architecture",
      "React admin + Astro public site",
      "Docker + Caddy on EC2",
      "PDF generation for inquiries",
    ],
    comingSoon: true,
  },
  llmgateway: {
    title: "Multi-LLM Gateway",
    summary:
      "Scalable backend bridging LINE Messaging API with OpenAI & xAI Grok.",
    tech: [
      "Python",
      "FastAPI",
      "Redis",
      "LINE Messaging API",
      "OpenAI API",
      "xAI Grok",
    ],
    highlights: [
      "Onion Architecture for decoupling",
      "Async/Await for high concurrency",
      "Redis state management",
    ],
    repoUrl: "https://github.com/doluludadada/chat_friend",
  },
};

const project = projects[slug];
---

<BaseLayout
  title={`${project.title} | YiShiou`}
  description={project.summary}
  lang="en"
>
  <div class="px-6 lg:px-16 xl:px-24 py-12">
    <a
      href="/projects"
      class="inline-flex items-center gap-2 text-zinc-400 hover:text-cyan-400 transition-colors mb-8 group"
    >
      <ArrowLeft
        className="w-4 h-4 group-hover:-translate-x-1 transition-transform"
      />
      Back to Projects
    </a>

    <header class="mb-12">
      <h1 class="text-4xl lg:text-5xl font-bold text-zinc-100 mb-4">
        {project.title}
      </h1>
      <p class="text-xl text-zinc-400 leading-relaxed max-w-3xl">
        {project.summary}
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        {
          project.repoUrl ? (
            <a
              href={project.repoUrl}
              target="_blank"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-800 hover:bg-zinc-900 text-zinc-100 transition-colors"
            >
              <Github className="w-4 h-4" /> Source Code
            </a>
          ) : (
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-800 text-zinc-500">
              <Lock className="w-4 h-4" /> Enterprise (Proprietary)
            </span>
          )
        }
        {
          project.comingSoon && (
            <span class="px-4 py-2 rounded-lg bg-cyan-500/10 text-cyan-400">
              Coming Soon
            </span>
          )
        }
      </div>
    </header>

    <hr class="border-zinc-800 mb-12" />

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
      <div class="lg:col-span-3 space-y-8">
        <section>
          <h2
            class="text-xl font-semibold text-zinc-100 mb-4 flex items-center gap-2"
          >
            <Zap className="w-5 h-5 text-cyan-400" /> Highlights
          </h2>
          <ul class="space-y-3">
            {
              project.highlights.map((h: string) => (
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 mt-2 shrink-0" />
                  <span class="text-zinc-400">{h}</span>
                </li>
              ))
            }
          </ul>
        </section>

        {
          project.metrics && (
            <section>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {project.metrics.map((m: any) => (
                  <div class="p-4 rounded-xl bg-zinc-900 border border-zinc-800">
                    <p class="text-sm text-zinc-400">{m.label}</p>
                    <p class="text-3xl font-bold text-cyan-400">{m.value}</p>
                    <p class="text-xs text-zinc-500">{m.sub}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside>
        <div
          class="sticky top-24 p-6 rounded-xl bg-zinc-900 border border-zinc-800"
        >
          <h3
            class="text-sm font-semibold text-zinc-100 uppercase tracking-wider mb-4 flex items-center gap-2"
          >
            <Code2 className="w-4 h-4" /> Tech Stack
          </h3>
          <div class="flex flex-wrap gap-2">
            {
              project.tech.map((t: string) => (
                <span class="px-2 py-1 rounded-md bg-zinc-800 text-zinc-400 text-xs font-mono">
                  {t}
                </span>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

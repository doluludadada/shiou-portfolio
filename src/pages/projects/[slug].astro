---
import ProjectDetail from "@/features/projects/components/ProjectDetail.astro";
import { getProjectPageData } from "@/features/projects/utils";
import { projectsConfig } from "@/features/projects/config";
import BaseLayout from "@/shared/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return projectsConfig.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;
const lang = "en";

const pageData = getProjectPageData(slug!, lang);

if (!pageData) {
  return Astro.redirect("/404");
}
---

<BaseLayout
  title={`${pageData.title} | YiShiou`}
  description={pageData.summary}
  lang={lang}
>
  <ProjectDetail lang={lang} data={pageData} />
</BaseLayout>

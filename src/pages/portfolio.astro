---
import HeroSection from "@/features/hero/HeroSection.astro";
import BentoGrid from "@/features/bento/BentoGrid.astro";
import ProjectList from "@/features/projects/components/ProjectList.astro";
import Timeline from "@/features/timeline/components/Timeline.astro";
import ContactSection from "@/features/contact/ContactSection.astro";
import ImpactSection from "@/features/impact/ImpactSection.astro";
import { useTranslations } from "@/shared/i18n/utils";
import BaseLayout from "@/shared/layouts/BaseLayout.astro";

const lang = "en";
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t("hero.name")} | ${t("hero.role")}`}
  description={t("hero.tagline")}
  lang={lang}
>
  <HeroSection lang={lang} />
  <BentoGrid lang={lang} />
  <ImpactSection lang={lang} />
  <Timeline lang={lang} />
  <ProjectList lang={lang} featuredOnly={true} showViewAll={true} />
  <ContactSection lang={lang} />
</BaseLayout>

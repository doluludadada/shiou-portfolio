---
import ProjectList from "@/features/projects/components/ProjectList.astro";
import { useTranslations } from "@/shared/i18n/utils";
import BaseLayout from "@/shared/layouts/BaseLayout.astro";

const lang = "zh";
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t("nav.projects")} | ${t("hero.name")}`}
  description={t("projects.subtitle")}
  lang={lang}
>
  <div class="pt-8">
    <ProjectList lang={lang} featuredOnly={false} showViewAll={false} />
  </div>
</BaseLayout>
